{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranchPatterns": ["main"],

  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,

  "labels": ["dependencies"],
  "assignees": ["carlonoelle"],

  "automergeStrategy": "squash",
  "automergeType": "pr",

  "schedule": ["before 6am on monday"],

  "minimumReleaseAge": "3 days",

  "lockFileMaintenance": {
    "description": "Refresh bun.lock weekly so transitive deps pick up fixes",
    "enabled": true,
    "automerge": true
  },

  "vulnerabilityAlerts": {
    "description": "Security fixes bypass the schedule and the release-age delay",
    "schedule": null,
    "minimumReleaseAge": null,
    "labels": ["dependencies", "security"],
    "automerge": true
  },

  "packageRules": [
    {
      "description": "dotenv-expand tags a 1000.0.0 sentinel release as latest — stay on real semver",
      "matchPackageNames": ["dotenv-expand"],
      "allowedVersions": "<1000.0.0"
    },
    {
      "description": "ESLint 10 blocked: eslint-plugin-react (via eslint-config-next) peers on eslint ^9.7",
      "matchPackageNames": ["eslint"],
      "allowedVersions": "<10.0.0"
    },
    {
      "description": "TypeScript 7 blocked: typescript-eslint peers on typescript <6.1.0",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1.0"
    },

    {
      "description": "Group all patch updates into a single PR",
      "matchUpdateTypes": ["patch"],
      "groupName": "All patch updates"
    },
    {
      "description": "Group Next.js + React ecosystem — they move together",
      "matchPackageNames": ["next", "react", "react-dom", "eslint-config-next"],
      "groupName": "Next.js / React"
    },
    {
      "description": "Group all Radix UI packages",
      "matchPackageNames": ["@radix-ui/{/,}**"],
      "groupName": "Radix UI"
    },
    {
      "description": "Group Drizzle ORM + kit together (schema changes may be needed)",
      "matchPackageNames": ["drizzle-orm", "drizzle-kit"],
      "groupName": "Drizzle"
    },
    {
      "description": "Group AI SDK packages",
      "matchPackageNames": ["ai", "@ai-sdk/openai", "@openrouter/ai-sdk-provider"],
      "groupName": "AI SDK"
    },
    {
      "description": "Group Sentry packages",
      "matchPackageNames": ["@sentry/{/,}**"],
      "groupName": "Sentry"
    },
    {
      "description": "Group TypeScript + type definitions",
      "matchPackageNames": ["typescript", "@types/{/,}**"],
      "groupName": "TypeScript & types"
    },

    {
      "description": "Automerge patch + minor once CI is green — this is the hands-off path",
      "matchUpdateTypes": ["patch", "minor", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Majors always get a human. CI here is lint + build with no tests, and a merge to main deploys to production and restores the prod DB.",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major"]
    }
  ],

  "ignorePaths": ["**/node_modules/**"]
}
