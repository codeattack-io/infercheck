{
  "name": "infercheck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css,mjs,cjs}\"",
    "import": "bun run scripts/import-models-dev.ts",
    "validate": "bun run scripts/validate-data.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "sync:models": "bun run scripts/sync-models.ts",
    "sync:models:dry": "bun run scripts/sync-models.ts --dry-run",
    "research:providers": "bun run scripts/research-providers.ts --all",
    "research:provider": "bun run scripts/research-providers.ts --provider",
    "translate:providers": "bun run scripts/translate-providers.ts --all",
    "translate:provider": "bun run scripts/translate-providers.ts --provider"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.51",
    "@aws-sdk/client-bedrock": "^3.1121.0",
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/nextjs": "^10.72.0",
    "ai": "^7.0.84",
    "drizzle-orm": "^0.45.2",
    "fuse.js": "^7.5.0",
    "next": "16.4.3",
    "next-intl": "^4.14.1",
    "p-queue": "^10.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "dotenv": "^18.0.0",
    "dotenv-expand": "^13.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@sentry/cli",
    "sharp",
    "unrs-resolver"
  ]
}
